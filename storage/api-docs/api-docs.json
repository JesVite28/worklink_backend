                    },
                    "401": {
                        "description": "No autorizado. Token requerido o inválido"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Users"
                ],
                "summary": "Actualizar usuario",
                "operationId": "updateUser",
                "responses": {
                    "200": {
                        "description": "Usuario actualizado exitosamente"
                    },
                    "401": {
                        "description": "No autorizado. Token requerido o inválido"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Users"
                ],
                "summary": "Eliminar usuario",
                "operationId": "deleteUser",
                "responses": {
